{
  "name": "2027spring-exam",
  "version": "1.0.0",
  "private": true,
  "description": "2027 广东春季高考复习网站（Vercel 部署入口）",
  "type": "module",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:setup": "npm --prefix backend run db:setup",
    "build:frontend": "npm --prefix frontend run build",
    "seed:undergraduate": "cd backend && node prisma/seed-undergraduate.js",
    "generate:undergraduate": "cd backend && node scripts/generateUndergraduateQuestions.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@vercel/blob": "^0.27.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.7.1",
    "uuid": "^9.0.1"
  }
}